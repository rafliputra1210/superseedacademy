# ==============================================================================
# ROOT SECURITY .HTACCESS FOR LARAVEL ON SHARED HOSTING (cPanel / Apache)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. BLOKIR MUTLAK AKSES KE FILE SENSITIF (.env, .git, artisan, composer, dll.)
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package\.(json|lock) - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^phpunit\.xml - [F,L,NC]
    RewriteRule ^storage/logs/.* - [F,L,NC]

    # 2. Redirect jika DocumentRoot server berada di folder root ini (bukan di /public)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Matikan Directory Browsing / Indexing
Options -Indexes

# Blokir akses ke file tersembunyi (dotfiles)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir akses ke file konfigurasi, database, backup, dan arsip
<FilesMatch "(?i)\.(env|log|sql|sqlite|sqlite3|db|bak|backup|config|ini|sh|yml|yaml|md|lock|zip|tar|gz|tgz|rar|7z|stackdump)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
